rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    match /rides/{rideId} {
      // For prototype: allow authenticated users to read and write rides.
      // In production, this should be restricted to the passenger who created it and the assigned driver.
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.passengerId == request.auth.uid;
      allow update: if isAuthenticated();
    }
  }
}
